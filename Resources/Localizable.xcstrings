    "Every app here reaches the internet only through this server. Without one, all its traffic is blocked." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هر برنامهٔ اینجا فقط از طریق این سرور به اینترنت می‌رسد. بدون سرور، همهٔ ترافیک آن مسدود است."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里的每个应用只能通过此服务器访问互联网。没有服务器时，所有流量都会被阻止。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждое приложение здесь выходит в интернет только через этот сервер. Без него весь трафик заблокирован."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يصل أي تطبيق هنا إلى الإنترنت إلا عبر هذا الخادم. ومن دونه تُحظر كل حركة بياناته."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi ứng dụng ở đây chỉ truy cập Internet qua máy chủ này. Nếu không có máy chủ, toàn bộ lưu lượng sẽ bị chặn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這裡的每個應用只能通過此伺服器訪問互聯網。沒有伺服器時，所有流量都會被阻止。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဤနေရာရှိ အက်ပ်အားလုံးသည် ဤဆာဗာမှတစ်ဆင့်သာ အင်တာနက်သုံးနိုင်သည်။ ဆာဗာမရှိလျှင် ကွန်ရက်အသွားအလာအားလုံးကို ပိတ်ပင်ထားမည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buradaki her uygulama internete yalnızca bu sunucu üzerinden erişir. Sunucu olmazsa tüm trafiği engellenir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque app accède à Internet uniquement par ce serveur. Sans serveur, tout son trafic est bloqué."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہاں ہر ایپ صرف اسی سرور کے ذریعے انٹرنیٹ تک پہنچتی ہے۔ سرور کے بغیر اس کی تمام ٹریفک مسدود رہتی ہے۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as aplicações aqui acedem à Internet apenas através deste servidor. Sem servidor, todo o tráfego é bloqueado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede App hier erreicht das Internet nur über diesen Server. Ohne Server wird ihr gesamter Datenverkehr blockiert."
          }
        }
      }
    },

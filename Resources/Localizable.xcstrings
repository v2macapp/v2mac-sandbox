    "The first search of the day downloads Debian's package list, which can take a few minutes." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اولین جستجوی هر روز فهرست بسته‌های دبیان را دانلود می‌کند و ممکن است چند دقیقه طول بکشد."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天的第一次搜索会下载 Debian 软件包列表，可能需要几分钟。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Первый поиск за день загружает список пакетов Debian, это может занять несколько минут."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينزّل أول بحث في اليوم قائمة حزم Debian، وقد يستغرق ذلك بضع دقائق."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lần tìm kiếm đầu tiên trong ngày sẽ tải danh sách gói Debian và có thể mất vài phút."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天的第一次搜索會下載 Debian 軟體包列表，可能需要幾分鐘。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "နေ့စဉ် ပထမဆုံးရှာဖွေချိန်တွင် Debian ဆော့ဖ်ဝဲအထုပ်စာရင်းကို ဒေါင်းလုဒ်လုပ်သဖြင့် မိနစ်အနည်းငယ် ကြာနိုင်သည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günün ilk aramasında Debian'ın paket listesi indirilir; bu birkaç dakika sürebilir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première recherche de la journée télécharge la liste des paquets Debian, ce qui peut prendre quelques minutes."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دن کی پہلی تلاش پر Debian کی پیکیج فہرست ڈاؤن لوڈ ہوتی ہے، جس میں چند منٹ لگ سکتے ہیں۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A primeira pesquisa do dia transfere a lista de pacotes Debian, o que pode demorar alguns minutos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die erste Suche des Tages lädt die Debian-Paketliste herunter. Dies kann einige Minuten dauern."
          }
        }
      }
    },

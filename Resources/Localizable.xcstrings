    "The store index has expired; installs and updates wait for a new one." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فهرست فروشگاه منقضی شده است؛ نصب و به‌روزرسانی منتظر فهرست جدید می‌ماند."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "商店索引已过期；安装和更新将等待新的索引。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Индекс магазина устарел; установка и обновления ждут нового."

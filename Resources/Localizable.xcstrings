    "A mini VM is a separate computer for your apps, with its own exit and its own data." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماشین مجازی کوچک یک رایانهٔ جدا برای برنامه‌های شماست، با خروجی و داده‌های خودش."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "迷你虚拟机是为你的应用准备的独立电脑，有自己的出口和自己的数据。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мини-ВМ — отдельный компьютер для ваших приложений, со своим выходом и своими данными."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الآلة الافتراضية المصغّرة حاسوب مستقل لتطبيقاتك، له منفذه وبياناته الخاصة."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy ảo mini là một máy tính riêng cho các ứng dụng, có lối ra và dữ liệu riêng."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "迷你虛擬機是為你的應用準備的獨立電腦，有自己的出口和自己的資料。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mini VM သည် သင့်အက်ပ်များအတွက် သီးခြားကွန်ပျူတာဖြစ်ပြီး ကိုယ်ပိုင်ကွန်ရက်အထွက်နှင့် ဒေတာ ရှိသည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

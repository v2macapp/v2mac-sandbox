    "Files the mini VMs write are not being marked as downloaded. Use Export to copy them to your Mac." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فایل‌هایی که ماشین‌های مجازی کوچک می‌نویسند نشان «دانلودشده» نمی‌گیرند. برای کپی آن‌ها به مک از «خروجی گرفتن» استفاده کنید."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "迷你虚拟机写入的文件未被标记为已下载。请使用“导出”把它们复制到 Mac。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файлы, которые записывают мини-ВМ, не помечаются как загруженные. Чтобы скопировать их на Mac, используйте «Экспорт»."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توضع علامة «تم التنزيل» على الملفات التي تكتبها الآلات الافتراضية المصغّرة. استخدم «تصدير» لنسخها إلى Mac."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tệp do máy ảo mini ghi không được đánh dấu là đã tải xuống. Hãy dùng Xuất để sao chép chúng sang máy Mac."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "迷你虛擬機寫入的檔案未被標記為已下載。請使用“導出”把它們複製到 Mac。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mini VM များ ရေးသားသည့် ဖိုင်များကို ဒေါင်းလုဒ်လုပ်ထားကြောင်း မှတ်သားမပေးနိုင်ပါ။ Mac သို့ ကူးယူရန် «ထုတ်ယူရန်» ကို သုံးပါ။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mini VM'lerin yazdığı dosyalar indirilmiş olarak işaretlenmez. Mac'inize kopyalamak için Dışa Aktar'ı kullanın."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers écrits par les mini-VM ne sont pas marqués comme téléchargés. Utilisez Exporter pour les copier sur votre Mac."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چھوٹی VMs کی لکھی ہوئی فائلوں پر ڈاؤن لوڈ شدہ کا نشان نہیں لگ رہا۔ انہیں اپنے Mac پر نقل کرنے کے لیے «برآمد کریں» استعمال کریں۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ficheiros escritos pelas mini VMs não estão a ser marcados como transferidos. Use Exportar para os copiar para o Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von Mini-VMs geschriebene Dateien werden nicht als heruntergeladen markiert. Verwenden Sie Exportieren, um sie auf Ihren Mac zu kopieren."
          }
        }
      }
    },
    "Only files and folders inside this mini VM's Shared folder can be exported." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط فایل‌ها و پوشه‌های داخل پوشهٔ Shared این ماشین مجازی کوچک قابل خروجی گرفتن هستند."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只能导出此迷你虚拟机 Shared 文件夹中的文件和文件夹。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспортировать можно только файлы и папки из папки Shared этой мини-ВМ."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن تصدير سوى الملفات والمجلدات الموجودة داخل المجلد المشترك لهذه الآلة الافتراضية المصغّرة."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",

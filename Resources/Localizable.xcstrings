    "It has no window app. Use it in the Terminal of any mini VM." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامهٔ پنجره‌دار ندارد. از آن در ترمینال هر مینی‌VM استفاده کنید."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它没有窗口应用。请在任一迷你虚拟机的终端中使用。"
          }

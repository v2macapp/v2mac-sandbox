    "%@ in %@ wants to play sound." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ در %@ می‌خواهد صدا پخش کند."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 中的 %1$@ 想要播放声音。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ в %@ хочет воспроизвести звук."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يريد %@ في %@ تشغيل الصوت."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ trong %@ muốn phát âm thanh."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 中的 %1$@ 想要播放聲音。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ သည် %@ ထဲတွင် အသံဖွင့်လိုသည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@ içinde ses çalmak istiyor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dans %@ souhaite lire du son."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@، %@ میں آواز چلانا چاہتی ہے۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ em %@ pretende reproduzir som."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in %@ möchte Ton wiedergeben."
          }
        }
      }
    },
    "%@ in %@ wants to use the SSH keys in your Mac's ssh-agent." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ در %@ می‌خواهد از کلیدهای SSH در ssh-agent مک شما استفاده کند."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 中的 %1$@ 想要使用你 Mac 的 ssh-agent 中的 SSH 密钥。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ в %@ хочет использовать SSH-ключи из ssh-agent вашего Mac."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يريد %@ في %@ استخدام مفاتيح SSH الموجودة في ssh-agent على Mac."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ trong %@ muốn dùng các khóa SSH trong ssh-agent của máy Mac."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 中的 %1$@ 想要使用你 Mac 的 ssh-agent 中的 SSH 密鑰。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ သည် %@ ထဲတွင် သင့် Mac ၏ ssh-agent ရှိ SSH သော့များကို သုံးလိုသည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@ içinde Mac'inizin ssh-agent'indaki SSH anahtarlarını kullanmak istiyor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dans %@ souhaite utiliser les clés SSH du ssh-agent de votre Mac."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@، %@ میں آپ کے Mac کے ssh-agent میں موجود SSH کلیدیں استعمال کرنا چاہتی ہے۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ em %@ pretende usar as chaves SSH do ssh-agent do Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in %@ möchte die SSH-Schlüssel im ssh-agent Ihres Macs verwenden."
          }
        }
      }
    },

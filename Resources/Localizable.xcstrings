    "Start it to open your apps. Each mini VM reaches the internet only through the server you pick for it." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای باز کردن برنامه‌ها آن را شروع کنید. هر ماشین مجازی کوچک فقط از طریق سروری که برایش انتخاب می‌کنید به اینترنت می‌رسد."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启动后即可打开你的应用。每个迷你虚拟机只能通过你为它选择的服务器访问互联网。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запустите её, чтобы открыть приложения. Каждая мини-ВМ выходит в интернет только через выбранный для неё сервер."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّلها لفتح تطبيقاتك. لا تصل كل آلة افتراضية مصغّرة إلى الإنترنت إلا عبر الخادم الذي تختاره لها."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khởi động để mở các ứng dụng. Mỗi máy ảo mini chỉ truy cập Internet qua máy chủ bạn chọn cho nó."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啓動後即可打開你的應用。每個迷你虛擬機只能通過你為它選擇的伺服器訪問互聯網。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင့်အက်ပ်များကို ဖွင့်ရန် စတင်ပါ။ Mini VM တစ်ခုစီသည် ၎င်းအတွက် သင်ရွေးထားသည့် ဆာဗာမှတစ်ဆင့်သာ အင်တာနက်သုံးနိုင်သည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamalarınızı açmak için başlatın. Her mini VM internete yalnızca seçtiğiniz sunucu üzerinden erişir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarrez-la pour ouvrir vos apps. Chaque mini-VM accède à Internet uniquement par le serveur que vous lui choisissez."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنی ایپس کھولنے کے لیے اسے شروع کریں۔ ہر چھوٹی VM صرف آپ کے منتخب کردہ سرور کے ذریعے انٹرنیٹ تک پہنچتی ہے۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie-o para abrir as suas aplicações. Cada mini VM acede à Internet apenas através do servidor que escolher para ela."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starten Sie die Sandbox, um Ihre Apps zu öffnen. Jede Mini-VM erreicht das Internet nur über den dafür gewählten Server."
          }
        }
      }
    },

    "Unchanged since it was published. Verified doesn't mean safe: check its permissions." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از زمان انتشار تغییر نکرده است. تأییدشده به معنای امن نیست: مجوزهایش را بررسی کنید."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自发布以来未被更改。已验证不代表安全：请检查其权限。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не изменялось с момента публикации. «Проверено» не значит «безопасно»: проверьте его разрешения."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتغير منذ نشره. التوثيق لا يعني أنه آمن: راجع أذوناته."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thay đổi kể từ khi phát hành. Được xác minh không có nghĩa là an toàn: hãy kiểm tra các quyền."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自發佈以來未被更改。已驗證不代表安全：請檢查其權限。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ထုတ်ဝေချိန်မှစ၍ မပြောင်းလဲပါ။ အတည်ပြုထားတိုင်း လုံခြုံသည်ဟု မဆိုလိုပါ။ ခွင့်ပြုချက်များကို စစ်ဆေးပါ။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yayımlandığından beri değişmedi. Doğrulanmış olması güvenli olduğu anlamına gelmez; izinlerini kontrol edin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inchangée depuis sa publication. « Vérifiée » ne signifie pas sûre : vérifiez ses autorisations."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشاعت کے بعد سے کوئی تبدیلی نہیں ہوئی۔ تصدیق شدہ ہونے کا مطلب محفوظ ہونا نہیں: اس کی اجازتیں جانچیں۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem alterações desde a publicação. Verificado não significa seguro: consulte as permissões."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit Veröffentlichung unverändert. Verifiziert bedeutet nicht sicher: Prüfen Sie die Berechtigungen."
          }
        }
      }
    },

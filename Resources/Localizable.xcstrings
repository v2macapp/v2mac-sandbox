      }
    },
    "V2Mac reviewed its settings. Its Debian packages (%@) are signed and updated by Debian, and shared by all mini VMs." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac تنظیماتش را بررسی کرده است. بسته‌های Debian آن (%@) توسط Debian امضا و به‌روزرسانی می‌شوند و بین همهٔ ماشین‌های مجازی کوچک مشترک‌اند."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac 审核了它的设置。它的 Debian 软件包（%@）由 Debian 签名和更新，并由所有迷你虚拟机共享。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac проверил его настройки. Его пакеты Debian (%@) подписывает и обновляет Debian, и они общие для всех мини-ВМ."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راجع V2Mac إعداداته. حزم Debian الخاصة به (%@) موقّعة ويحدّثها Debian، وتتشاركها جميع الآلات الافتراضية المصغّرة."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac đã đánh giá cài đặt. Các gói Debian (%@) được Debian ký và cập nhật, đồng thời được mọi máy ảo mini dùng chung."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac 審核了它的設定。它的 Debian 軟體包（%@）由 Debian 簽名和更新，並由所有迷你虛擬機共享。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac က ၎င်း၏ဆက်တင်များကို စစ်ဆေးထားသည်။ ၎င်း၏ Debian ဆော့ဖ်ဝဲအထုပ်များ (%@) ကို Debian က ဒစ်ဂျစ်တယ်လက်မှတ်ထိုးပြီး အဆင့်မြှင့်ပေးကာ Mini VM အားလုံး မျှဝေသုံးသည်။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac ayarlarını inceledi. Debian paketleri (%@), Debian tarafından imzalanıp güncellenir ve tüm mini VM'lerce paylaşılır."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac a vérifié ses réglages. Ses paquets Debian (%@) sont signés et mis à jour par Debian, et partagés par toutes les mini-VM."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac نے اس کی ترتیبات کا جائزہ لیا۔ اس کے Debian پیکیجز (%@) پر Debian ڈیجیٹل دستخط کرتا اور انہیں تازہ کرتا ہے، اور یہ تمام چھوٹی VMs میں مشترک ہوتے ہیں۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O V2Mac reviu as definições. Os pacotes Debian (%@) são assinados e atualizados pelo Debian e partilhados por todas as mini VMs."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V2Mac hat die Einstellungen geprüft. Die Debian-Pakete (%@) werden von Debian signiert und aktualisiert und von allen Mini-VMs gemeinsam verwendet."
          }
        }
      }
    },
    "“%@” could not be marked as downloaded, so it was not exported." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» نشان «دانلودشده» نگرفت، پس خروجی گرفته نشد."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”无法标记为已下载，因此未导出。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» не удалось пометить как загруженный, поэтому он не экспортирован."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر وضع علامة «تم التنزيل» على «%@»، لذلك لم يُصدّر."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể đánh dấu “%@” là đã tải xuống nên tệp không được xuất."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”無法標記為已下載，因此未導出。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ကို ဒေါင်းလုဒ်လုပ်ထားကြောင်း မှတ်သားမပေးနိုင်သဖြင့် မထုတ်ယူခဲ့ပါ။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” indirilmiş olarak işaretlenemediği için dışa aktarılmadı."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’a pas pu être marqué comme téléchargé et n’a donc pas été exporté."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” پر ڈاؤن لوڈ شدہ کا نشان نہیں لگ سکا، اس لیے اسے برآمد نہیں کیا گیا۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível marcar «%@» como transferido, pelo que não foi exportado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ konnte nicht als heruntergeladen markiert werden und wurde deshalb nicht exportiert."
          }
        }
      }
    },
    "“%@” could not be marked as downloaded, so macOS won't warn before opening it. Use Export to copy files to your Mac." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» نشان «دانلودشده» نگرفت، پس macOS پیش از باز کردنش هشدار نمی‌دهد. برای کپی فایل‌ها به مک از «خروجی گرفتن» استفاده کنید."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”无法标记为已下载，macOS 打开前不会警告。请使用“导出”把文件复制到 Mac。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» не удалось пометить как загруженный, поэтому macOS не предупредит перед его открытием. Чтобы скопировать файлы на Mac, используйте «Экспорт»."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر وضع علامة «تم التنزيل» على «%@»، لذلك لن يحذّر macOS قبل فتحه. استخدم «تصدير» لنسخ الملفات إلى Mac."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể đánh dấu “%@” là đã tải xuống nên macOS sẽ không cảnh báo trước khi mở. Hãy dùng Xuất để sao chép tệp sang máy Mac."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”無法標記為已下載，macOS 打開前不會警告。請使用“導出”把檔案複製到 Mac。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ကို ဒေါင်းလုဒ်လုပ်ထားကြောင်း မှတ်သားမပေးနိုင်သဖြင့် macOS က မဖွင့်မီ သတိပေးမည် မဟုတ်ပါ။ ဖိုင်များကို Mac သို့ ကူးယူရန် «ထုတ်ယူရန်» ကို သုံးပါ။"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” indirilmiş olarak işaretlenemediği için macOS açmadan önce uyarmaz. Dosyaları Mac'inize kopyalamak için Dışa Aktar'ı kullanın."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’a pas pu être marqué comme téléchargé ; macOS n’avertira donc pas avant son ouverture. Utilisez Exporter pour copier des fichiers sur votre Mac."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” پر ڈاؤن لوڈ شدہ کا نشان نہیں لگ سکا، اس لیے macOS اسے کھولنے سے پہلے خبردار نہیں کرے گا۔ فائلیں اپنے Mac پر نقل کرنے کے لیے «برآمد کریں» استعمال کریں۔"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível marcar «%@» como transferido, pelo que o macOS não avisará antes de o abrir. Use Exportar para copiar ficheiros para o Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ konnte nicht als heruntergeladen markiert werden. macOS wird deshalb vor dem Öffnen nicht warnen. Verwenden Sie Exportieren, um Dateien auf Ihren Mac zu kopieren."
